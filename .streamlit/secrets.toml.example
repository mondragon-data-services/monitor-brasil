# Copie para .streamlit/secrets.toml (local, NUNCA versionado) ou cole no painel do Streamlit Cloud:
#   App > Settings > Secrets
# Nunca cole a chave no chat, em issues, commits ou código.

OPENAI_API_KEY = "sk-..."          # use uma chave de PROJETO dedicada, com limite de gasto no painel da OpenAI

# Opcionais (os valores abaixo são os padrões)
# OPENAI_MODEL = "gpt-5-mini"      # troque por "gpt-4.1-mini" se sua conta não tiver acesso
# AGENT_ENABLED = true             # false desliga o agente na hora (kill switch)
# AGENT_CLIENT_DAILY = 5           # perguntas/dia por visitante (IP) — impede burlar com F5; 0 desliga esta camada
# AGENT_DEBUG = false              # true mostra no agente se o IP público foi detectado (diagnóstico)
# AGENT_GLOBAL_DAILY = 200         # perguntas/dia no app inteiro (disjuntor de custo)
# AGENT_TOKENS_DAILY = 800000      # tokens/dia no app inteiro
# AGENT_COOLDOWN_S = 8             # segundos mínimos entre perguntas da mesma sessão
# (o limite de 5 perguntas por sessão é fixo no código)
